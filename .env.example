# 指向现有 API Worker 的公网 origin，不要填写 Console 域名或追加 /api。
API_BASE_URL=https://your-footprint-api.workers.dev
# 与现有 API Worker 的 INGEST_TOKEN 相同，只由本项目服务端读取。
INGEST_TOKEN=

# 仅 pk. 开头的公开 Token 会发给浏览器。
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# pnpm start 的访问密码；pnpm dev / preview 只监听本机，跳过控制台登录。
CONSOLE_AUTH=basic
CONSOLE_USERNAME=footprint
CONSOLE_PASSWORD=

HOST=127.0.0.1
PORT=3000
# 经 HTTPS 反向代理访问时，填写浏览器看到的 origin，以便校验项目写入请求。
# PUBLIC_ORIGIN=https://footprint.example.com
