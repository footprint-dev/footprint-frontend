# Allowed values: serverless (default) or serverful.
API_BACKEND=serverless

# Public Serverless API origin, without /api. Replace this example with your deployed API Worker.
# For Serverful, use http://127.0.0.1:8080 and set API_BACKEND=serverful.
API_BASE_URL=https://your-footprint-api.workers.dev

# Used only for serverless. Serverful reads the [mapbox] section from config.toml.
# Only public tokens starting with pk. are sent to the browser.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

HOST=127.0.0.1
PORT=3000
# 经 HTTPS 反向代理访问时，填写浏览器看到的 origin，以便校验项目写入请求。
# PUBLIC_ORIGIN=https://footprint.example.com
